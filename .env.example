# Clave para entrar a /admin en producción.
ADMIN_PASSWORD=cambia-esta-clave

# Secreto largo y aleatorio para firmar la sesión administrativa.
# Puedes generarlo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_SESSION_SECRET=pega-aqui-un-secreto-largo-y-aleatorio
